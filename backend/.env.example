# MATCHLY backend configuration - copy to .env for local testing, or set these as
# environment variables in your hosting dashboard (Render, Railway, Fly ...).
# NEVER commit a real .env file. This file contains placeholders only.

# Sports data provider (only "api-football" is implemented in this version)
PROVIDER=api-football

# Your API-Football key (dashboard.api-football.com -> My Access). SECRET.
API_FOOTBALL_KEY=PUT_YOUR_API_FOOTBALL_KEY_HERE

# free  -> conservative caching for the 100-requests/day plan
# paid  -> faster refresh for Pro/Ultra/Mega plans
PLAN_PRESET=free

# Optional shared token. If set, the app must send it (Settings > Data source > App token).
# It deters casual abuse; it is embedded in the app so it is NOT a real secret.
APP_TOKEN=

# Optional overrides (leave empty to use the preset)
DAILY_REQUEST_BUDGET=
UPSTREAM_PER_MINUTE=
TTL_TODAY_SECONDS=
TTL_LIVE_SECONDS=
CLIENT_RATE_PER_MINUTE=120
PORT=8787
