<?xml version="1.0" encoding="utf-8"?>
<!-- Glass-inspired widget surface: translucent deep green gradient + thin luminous border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E60B2A1E"
        android:endColor="#F2041109"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#552ECC8F" />
</shape>
